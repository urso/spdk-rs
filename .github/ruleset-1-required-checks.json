{
  "name": "Branch Protection & Required Checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/develop",
        "refs/heads/develop-*",
        "refs/heads/release/*"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "commitlint"
          },
          {
            "context": "rust-lint"
          },
          {
            "context": "nix-lint"
          }
        ]
      }
    }
  ],
  "bypass_actors": []
}
